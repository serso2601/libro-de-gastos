{
  "expo": {
    "name": "Gastos",
    "slug": "libro-de-gastos",
    "scheme": "librogastos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0E13",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.serso.librodegastos",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#0B0E13"
        }
      ]
    ],
    "web": {
      "output": "single",
      "name": "Gastos",
      "shortName": "Gastos",
      "backgroundColor": "#0B0E13",
      "themeColor": "#0B0E13"
    },
    "experiments": {
      "baseUrl": "/app"
    }
  }
}
